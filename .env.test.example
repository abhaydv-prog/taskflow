POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_DB=taskflow_test

# Same Postgres container as dev, DIFFERENT database name — never point
# this at your dev database, or tests will wipe your real data.
DATABASE_URL="postgresql://taskflow:replace_with_your_password@localhost:5434/taskflow_test?schema=public"

# Not actually used for most tests (bullmq is mocked in tests/setup/mockQueue.ts),
# but kept here so nothing throws if any code path reads it.
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="test-access-secret-not-for-production-use-only"
JWT_REFRESH_SECRET="test-refresh-secret-not-for-production-use-only"

PORT=3000
NODE_ENV=test